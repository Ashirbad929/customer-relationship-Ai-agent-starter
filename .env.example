# Copy this file to .env. Spring Boot loads .env from the project directory.
FALKORDB_URL=redis://localhost:6379
FALKORDB_GRAPH=customer_relationships
SERVER_PORT=8080
AGENT_ENABLED=false
AI_PROVIDER=auto
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Required for OpenAI web search even if Gemini is selected for chat.
OPENAI_API_KEY=
